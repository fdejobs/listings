---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCompanies, getHistoricalSnapshots, getJobs, getMarketHistory, getMarketStats, getTickerItems, getTrackerSources } from "../lib/data";
import { countAddedThisWeek } from "../lib/filters";
import { stageLabel } from "../lib/format";
import { getLiveRoleMetric } from "../lib/metrics";

type WeekPoint = {
  key: string;
  label: string;
  value: number;
};

type MarketComparison = {
  baseline: number | null;
  change: number | null;
  percent: number | null;
};

const companies = getCompanies();
const jobs = getJobs();
const { currentLiveRoles, liveJobs } = getLiveRoleMetric(jobs, companies);
const tickerItems = getTickerItems();
const marketStats = getMarketStats();
const marketHistory = getMarketHistory();
const history = getHistoricalSnapshots();
const trackerSources = getTrackerSources();
const addedThisWeek = countAddedThisWeek(jobs);
const coreBaselineDate = new Date("2026-05-30T00:00:00.000Z");

function differenceLabel(change: number, window: "WoW" | "MoM" | "YTD") {
  return `${change > 0 ? "+" : ""}${change} ${window}`;
}

function changeClass(change: number | null) {
  if (change === null) {
    return "neutral";
  }
  if (change === 0) {
    return "neutral";
  }
  return change > 0 ? "positive" : "negative";
}

const marketWeeks: WeekPoint[] = marketHistory.map((point) => ({
  key: point.period_start.slice(0, 10),
  label: point.period_label,
  value: point.postings_count
}));

const coreMetric = currentLiveRoles;
const coreBaselineSnapshot = history.find((snapshot) => snapshot.date.slice(0, 10) === coreBaselineDate.toISOString().slice(0, 10));
const coreBaselineComparison = coreBaselineSnapshot
  ? {
      baseline: coreBaselineSnapshot.live_role_count,
      change: currentLiveRoles - coreBaselineSnapshot.live_role_count
    }
  : {
      baseline: null,
      change: null
    };
const maxMarketWeekly = Math.max(...marketWeeks.map((point) => point.value), 1);
const latestMarketPoint = marketHistory.at(-1);
const latestMarketValue = latestMarketPoint?.postings_count ?? null;
const marketSourceText = latestMarketPoint
  ? `Source: A16Z/Bloomberry proxy through Sep 2025, extended with public Indeed index anchors through Apr 2026 and a May 2026 proxy continuation. Monthly proxy counts; latest: ${latestMarketPoint.period_label}.`
  : "Source: Indeed FDE postings benchmark.";

function marketComparisonForBaseline(baseline: number | null): MarketComparison {
  if (latestMarketValue === null || baseline === null) {
    return { baseline: null, change: null, percent: null };
  }

  const change = latestMarketValue - baseline;
  return {
    baseline,
    change,
    percent: baseline === 0 ? null : Math.round((change / baseline) * 100)
  };
}

function findMarketPointMonthsBefore(months: number) {
  if (!latestMarketPoint) {
    return null;
  }

  const latest = new Date(latestMarketPoint.period_start);
  const target = new Date(Date.UTC(latest.getUTCFullYear(), latest.getUTCMonth() - months, 1));
  const targetMonth = target.toISOString().slice(0, 7);

  return marketHistory.find((point) => point.period_start.slice(0, 7) === targetMonth) ?? null;
}

const previousMarketPoint = findMarketPointMonthsBefore(1);
const ytdMarketPoint = marketHistory.find((point) => point.period_start.startsWith(`${latestMarketPoint?.period_start.slice(0, 4) ?? new Date().getUTCFullYear()}-`)) ?? null;
const marketMomComparison = marketComparisonForBaseline(previousMarketPoint?.postings_count ?? null);
const marketYtdComparison = marketComparisonForBaseline(ytdMarketPoint?.postings_count ?? null);

function marketComparisonText(comparison: MarketComparison, window: "MoM" | "YTD") {
  if (comparison.change === null || comparison.baseline === null) {
    return `${window} pending`;
  }

  const pct = comparison.percent === null ? "" : ` · ${comparison.percent > 0 ? "+" : ""}${comparison.percent}%`;
  return `${differenceLabel(comparison.change, window)}${pct}`;
}

function baselineComparisonText(comparison: { baseline: number | null; change: number | null }) {
  if (comparison.change === null || comparison.baseline === null) {
    return "30 May baseline pending";
  }

  return `${comparison.change > 0 ? "+" : ""}${comparison.change} since 30 May · from ${comparison.baseline}`;
}

function countBy(values: string[]) {
  const counts = new Map<string, number>();
  for (const value of values) {
    counts.set(value, (counts.get(value) ?? 0) + 1);
  }

  return Array.from(counts.entries()).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
}

function topRows(rows: Array<[string, number]>, limit: number, alwaysInclude: string[] = []) {
  const selected = rows.slice(0, limit);
  const required = alwaysInclude
    .filter((label) => !selected.some(([rowLabel]) => rowLabel === label))
    .map((label) => rows.find(([rowLabel]) => rowLabel === label))
    .filter((row): row is [string, number] => Boolean(row));

  if (required.length === 0) {
    return selected;
  }

  return [
    ...selected.slice(0, Math.max(0, limit - required.length)),
    ...required
  ].slice(0, limit);
}

function seniority(title: string) {
  const value = title.toLowerCase();
  if (/(director|head|manager|lead)/.test(value)) {
    return "Leadership";
  }
  if (/(principal|staff|senior|sr\.?)/.test(value)) {
    return "Senior IC";
  }
  if (/(junior|associate|graduate|intern)/.test(value)) {
    return "Early career";
  }
  return "Mid-level / unspecified";
}

const breakdowns = [
  {
    title: "Roles by company",
    rows: topRows(countBy(liveJobs.map((job) => job.company.name)), 10, ["Google Cloud"])
  },
  {
    title: "Roles by industry",
    rows: topRows(countBy(liveJobs.flatMap((job) => job.company.industry_tags)), 10, ["big tech / cloud", "genai / applied ai"])
  },
  {
    title: "Roles by country",
    rows: countBy(liveJobs.flatMap((job) => job.countries)).slice(0, 10)
  },
  {
    title: "Roles by seniority",
    rows: countBy(liveJobs.map((job) => seniority(job.title)))
  },
  {
    title: "Roles by remote / hybrid / onsite",
    rows: countBy(liveJobs.map((job) => job.location_type[0].toUpperCase() + job.location_type.slice(1)))
  },
  {
    title: "Roles by funding stage",
    rows: countBy(liveJobs.map((job) => stageLabel(job.company.stage)))
  }
];

const lastSourceRefresh = trackerSources
  .map((source) => source.observed_at)
  .sort()
  .at(-1);
---

<BaseLayout
  title="FDE Growth Tracker · FDE Collective"
  description="A weekly tracker for the rise of forward-deployed job volume by country, company, and industry."
  tickerItems={tickerItems}
  openRoleCount={liveJobs.length}
  addedThisWeek={addedThisWeek}
  marketStats={marketStats}
  showSurveyBanner
>
  <main class="site-shell">
    <section class="page-head page-head-narrow">
      <div class="eyebrow">Growth tracker</div>
      <h1 class="page-title">the rise of the FDE</h1>
      <p class="page-subhead">FDE job volume by country, company and industry</p>
    </section>

    <section class="timeseries-panel timeseries-panel-top" aria-label="FDE job postings by month">
      <div class="chart-heading">
        <div>
          <span class="eyebrow">Monthly role volume</span>
          <h2>FDE job postings by month</h2>
        </div>
        <div class="growth-change-stack">
          <span class={`metric-change ${changeClass(marketMomComparison.change)}`}>{marketComparisonText(marketMomComparison, "MoM")}</span>
          <span class={`metric-change ${changeClass(marketYtdComparison.change)}`}>{marketComparisonText(marketYtdComparison, "YTD")}</span>
        </div>
      </div>
      <div class="week-chart market-chart" style={`--point-count:${Math.max(marketWeeks.length, 1)}`}>
        {marketWeeks.map((point) => (
          <div class="week-bar" style={`--bar:${Math.max(4, Math.round((point.value / maxMarketWeekly) * 100))}%`}>
            <span>{point.value}</span>
            <div aria-hidden="true"><span></span></div>
            <strong>{point.label}</strong>
          </div>
        ))}
      </div>
      <p class="chart-source">{marketSourceText}</p>
    </section>

    <section class="growth-core" aria-label="Priority FDE Jobs">
      <div>
        <span class="eyebrow">Priority FDE Jobs</span>
        <strong>{coreMetric}</strong>
        <p>
          Current live FDE roles tracked across multiple sites
        </p>
      </div>
      <div class="growth-change-stack">
        <span class={`metric-change ${changeClass(coreBaselineComparison.change)}`} title="Comparison uses the corrected constant-sample 30 May 2026 baseline.">{baselineComparisonText(coreBaselineComparison)}</span>
        {lastSourceRefresh && <span class="metric-change neutral">Updated {new Date(lastSourceRefresh).toLocaleDateString("en-GB", { day: "2-digit", month: "short" })}</span>}
      </div>
    </section>

    <section class="chart-grid" aria-label="FDE role breakdowns">
      {breakdowns.map((breakdown) => {
        const max = Math.max(...breakdown.rows.map(([, value]) => value), 1);
        return (
          <section class="chart-panel">
            <h2>{breakdown.title}</h2>
            <div class="bar-chart">
              {breakdown.rows.map(([label, value]) => (
                <div class="bar-row" style={`--bar:${Math.max(4, Math.round((value / max) * 100))}%`}>
                  <span>{label}</span>
                  <div aria-hidden="true"><span></span></div>
                  <strong>{value}</strong>
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </section>

    <section class="source-note">
      <h2>Source</h2>
      <p>Source: audited live Forward Deployed Engineer listings across company careers pages and job boards, with weekly snapshots used for tracker WoW and MoM movement.</p>
      {lastSourceRefresh && <p class="mono micro">Source registry last observed {new Date(lastSourceRefresh).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })}</p>}
    </section>
  </main>
</BaseLayout>
